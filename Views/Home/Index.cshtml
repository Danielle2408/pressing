@{
    ViewData["Title"] = "Accueil";
}

<section class="py-5 py-lg-6">
    <div class="row align-items-center g-5">
        <div class="col-lg-7">
            <span class="badge rounded-pill text-bg-light border mb-3">Votre pressing, simplement</span>
            <h1 class="display-4 fw-bold mb-3">Le soin du linge, en toute sérénité.</h1>
            <p class="lead text-secondary mb-4">Retrouvez vos commandes et suivez chaque étape de leur traitement depuis votre espace client.</p>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <p class="fw-semibold text-primary mb-0">Bienvenue, @User.Identity.Name</p>
                <p class="text-secondary">Votre espace commandes sera disponible avec le prochain module.</p>
            }
            else
            {
                <a class="btn btn-primary btn-lg me-2" asp-controller="Compte" asp-action="Inscription">Créer un compte</a>
                <a class="btn btn-outline-secondary btn-lg" asp-controller="Compte" asp-action="Connexion">Se connecter</a>
            }
        </div>
        <div class="col-lg-5">
            <div class="home-card p-4 p-md-5 rounded-4">
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <span class="text-secondary small">Suivi de commande</span>
                    <span class="badge text-bg-success-subtle text-success-emphasis rounded-pill">Exemple</span>
                </div>
                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="order-icon">✦</div>
                    <div>
                        <div class="fw-semibold">Commande prête</div>
                        <div class="text-secondary small">Les détails arrivent bientôt dans votre espace.</div>
                    </div>
                </div>
                <div class="progress" role="progressbar" aria-label="Avancement de la commande" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100" style="height: 8px;">
                    <div class="progress-bar bg-success" style="width: 100%"></div>
                </div>
                <div class="d-flex justify-content-between text-secondary small mt-2">
                    <span>Reçue</span><span>Traitement</span><span>Prête</span>
                </div>
            </div>
        </div>
    </div>
</section>
