@model DashboardViewModel
@{
    ViewData["Title"] = Model.IsStaffDashboard ? "Tableau de bord" : "Accueil";
    var maxService = Math.Max(1m, Model.ServiceRevenue.Select(item => item.Amount).DefaultIfEmpty(0m).Max());
}

@if (Model.IsStaffDashboard && Model.IsAdministrator)
{
    <section class="py-4">
        <div class="mb-4"><span class="text-primary fw-semibold small text-uppercase">Administration</span><h1 class="display-6 fw-bold mt-2">Tableau de bord</h1><p class="text-secondary">Activité du pressing, période en cours.</p></div>
        <div class="row g-3 mb-4">
            <div class="col-sm-6 col-xl-3"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="small text-secondary">Commandes reçues aujourd’hui</div><div class="fs-2 fw-bold mt-2">@Model.ReceivedToday</div></div></div></div>
            <div class="col-sm-6 col-xl-3"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="small text-secondary">À remettre aujourd’hui</div><div class="fs-2 fw-bold mt-2">@Model.ReadyToday</div></div></div></div>
            <div class="col-sm-6 col-xl-3"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="small text-secondary">Livrées aujourd’hui</div><div class="fs-2 fw-bold mt-2">@Model.DeliveredToday</div></div></div></div>
            <div class="col-sm-6 col-xl-3"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="small text-secondary">En retard</div><div class="fs-2 fw-bold mt-2 @(Model.OverdueCount > 0 ? "text-danger" : "text-success")">@Model.OverdueCount</div></div></div></div>
        </div>
        <div class="row g-3 mb-4">
            <div class="col-md-4"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="small text-secondary">Recettes du jour <span class="text-nowrap">(veille : @Model.RevenueYesterday.ToString("N0"))</span></div><div class="fs-4 fw-bold mt-2">@Model.RevenueToday.ToString("N0") FCFA</div></div></div></div>
            <div class="col-md-4"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="small text-secondary">Recettes des 7 derniers jours</div><div class="fs-4 fw-bold mt-2">@Model.RevenueThisWeek.ToString("N0") FCFA</div><div class="small text-secondary">Période précédente : @Model.RevenuePreviousWeek.ToString("N0") FCFA</div></div></div></div>
            <div class="col-md-4"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="small text-secondary">Recettes du mois</div><div class="fs-4 fw-bold mt-2">@Model.RevenueThisMonth.ToString("N0") FCFA</div><div class="small text-secondary">Mois précédent : @Model.RevenuePreviousMonth.ToString("N0") FCFA</div></div></div></div>
        </div>
        <div class="row g-4">
            <div class="col-lg-6"><div class="card border-0 shadow-sm h-100"><div class="card-body p-4"><h2 class="h5">Alertes</h2>
                <div class="d-flex justify-content-between border-bottom py-2"><span>Stocks au seuil d’alerte</span><a asp-controller="Stocks" asp-action="Index" class="fw-semibold">@Model.LowStockCount</a></div>
                <div class="d-flex justify-content-between border-bottom py-2"><span>Commandes impayées depuis plus de 7 jours</span><a asp-controller="Commandes" asp-action="Index" class="fw-semibold">@Model.OldUnpaidCount</a></div>
                <div class="d-flex justify-content-between py-2"><span>Commandes en retard</span><a asp-controller="Commandes" asp-action="Index" class="fw-semibold">@Model.OverdueCount</a></div>
            </div></div></div>
            <div class="col-lg-6"><div class="card border-0 shadow-sm h-100"><div class="card-body p-4"><h2 class="h5">Répartition par service · mois en cours</h2>
                @if (Model.ServiceRevenue.Count == 0) { <p class="text-secondary mt-3">Pas encore de commandes sur la période.</p> }
                @foreach (var item in Model.ServiceRevenue)
                {
                    <div class="mt-3"><div class="d-flex justify-content-between small mb-1"><span>@item.Label</span><strong>@item.Amount.ToString("N0") FCFA</strong></div><div class="progress" style="height:8px"><div class="progress-bar" style="width:@((double)(item.Amount / maxService * 100))%"></div></div></div>
                }
            </div></div></div>
            <div class="col-lg-6"><div class="card border-0 shadow-sm"><div class="card-body p-4"><h2 class="h5">Meilleurs clients · mois en cours</h2>
                @if (Model.TopCustomers.Count == 0) { <p class="text-secondary mt-3">Pas encore de commandes sur la période.</p> }
                @foreach (var item in Model.TopCustomers) { <div class="d-flex justify-content-between border-bottom py-2"><span>@item.Label</span><strong>@item.Amount.ToString("N0") FCFA</strong></div> }
            </div></div></div>
        </div>
    </section>
}
else if (Model.IsStaffDashboard)
{
    <section class="py-4">
        <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4"><div><span class="text-primary fw-semibold small text-uppercase">Atelier</span><h1 class="display-6 fw-bold mt-2 mb-0">Tableau de bord opérateur</h1></div><a asp-controller="Commandes" asp-action="Creer" class="btn btn-primary">Nouvelle commande</a></div>
        <div class="row g-3 mb-4">
            @foreach (var item in Model.Workload.OrderBy(item => item.Status))
            {
                <div class="col-sm-6 col-lg-3"><a asp-controller="Commandes" asp-action="Index" asp-route-status="@((int)item.Status)" class="card border-0 shadow-sm h-100 text-decoration-none text-body"><div class="card-body"><div class="small text-secondary">@item.Status.ToFrench()</div><div class="fs-2 fw-bold mt-2">@item.Count</div></div></a></div>
            }
        </div>
        <div class="d-flex flex-wrap gap-2 mb-4"><a asp-controller="Clients" asp-action="Index" class="btn btn-outline-primary">Rechercher un client</a><a asp-controller="Caisse" asp-action="Index" class="btn btn-outline-primary">Clôturer la caisse</a><a asp-controller="Stocks" asp-action="Index" class="btn btn-outline-primary">Gérer les stocks</a></div>
        <div class="card border-0 shadow-sm overflow-hidden"><div class="card-body pb-0"><h2 class="h5">À rendre aujourd’hui ou en retard</h2></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Commande</th><th>Client</th><th>Statut</th><th>Échéance</th><th></th></tr></thead><tbody>
            @if (Model.UrgentOrders.Count == 0) { <tr><td colspan="5" class="text-center text-secondary py-4">Aucune commande urgente.</td></tr> }
            @foreach (var order in Model.UrgentOrders) { <tr><td class="fw-semibold">@order.Number</td><td>@order.Customer.FullName</td><td>@order.Status.ToFrench()</td><td>@order.ExpectedReadyAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td class="text-end"><a asp-controller="Commandes" asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-secondary">Ouvrir</a></td></tr> }
        </tbody></table></div></div>
    </section>
}
else if (User.IsInRole(Roles.Customer))
{
    <section class="py-5"><div class="row align-items-center g-5"><div class="col-lg-7"><span class="badge rounded-pill text-bg-light border mb-3">Espace client</span><h1 class="display-4 fw-bold mb-3">Le soin du linge, en toute sérénité.</h1><p class="lead text-secondary mb-4">Dépose une demande, suis chaque étape et retrouve l’historique de tes commandes.</p><a class="btn btn-primary btn-lg" asp-controller="EspaceClient" asp-action="Index">Accéder à mon espace</a></div><div class="col-lg-5"><div class="home-card p-4 p-md-5 rounded-4"><h2 class="h4">Ta prochaine commande</h2><p class="text-secondary mb-0">Retrouve son statut et les détails du service depuis ton espace client.</p></div></div></div></section>
}
else
{
    <section class="py-5 py-lg-6"><div class="row align-items-center g-5"><div class="col-lg-7"><span class="badge rounded-pill text-bg-light border mb-3">Votre pressing, simplement</span><h1 class="display-4 fw-bold mb-3">Le soin du linge, en toute sérénité.</h1><p class="lead text-secondary mb-4">Consultez les services, déposez une demande et suivez son traitement depuis votre espace client.</p><a class="btn btn-primary btn-lg me-2" asp-controller="Compte" asp-action="Inscription">Créer un compte</a><a class="btn btn-outline-secondary btn-lg" asp-controller="Compte" asp-action="Connexion">Se connecter</a></div><div class="col-lg-5"><div class="home-card p-4 p-md-5 rounded-4"><h2 class="h4">Un suivi clair</h2><p class="text-secondary mb-0">Chaque commande garde son historique de traitement et de paiement.</p></div></div></div></section>
}
