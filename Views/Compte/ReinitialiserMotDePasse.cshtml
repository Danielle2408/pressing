@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Nouveau mot de passe";
}

<div class="row justify-content-center py-5"><div class="col-12 col-md-7 col-lg-5"><div class="card border-0 shadow-sm"><div class="card-body p-4 p-md-5">
    <h1 class="h3 mb-2">Choisir un nouveau mot de passe</h1>
    <form asp-action="ReinitialiserMotDePasse" method="post">
        <input asp-for="UserId" type="hidden" /><input asp-for="Token" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" autocomplete="new-password" /><span asp-validation-for="Password" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="text-danger"></span></div>
        <button type="submit" class="btn btn-primary w-100">Réinitialiser mon mot de passe</button>
    </form>
</div></div></div></div>
