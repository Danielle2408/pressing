@model CatalogueViewModel
@{
    ViewData["Title"] = "Nos services et tarifs";
}

<section class="py-4">
    <div class="mb-4">
        <span class="text-primary fw-semibold small text-uppercase">Catalogue</span>
        <h1 class="display-6 fw-bold mt-2">Nos services et tarifs</h1>
        <p class="text-secondary">Les prix affichés sont en FCFA et s’appliquent aux articles actifs.</p>
    </div>

    @if (Model.Rates.Count == 0)
    {
        <div class="alert alert-light border">Le catalogue est en cours de préparation. Contacte le pressing pour connaître ses tarifs.</div>
    }
    else
    {
        <div class="card border-0 shadow-sm overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr><th>Article</th><th>Service</th><th class="text-end">Prix</th></tr>
                    </thead>
                    <tbody>
                    @foreach (var rate in Model.Rates)
                    {
                        <tr>
                            <td>@rate.Category</td>
                            <td>@rate.Service</td>
                            <td class="text-end fw-semibold">@rate.Price.ToString("N0") FCFA</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
        <p class="text-secondary small mt-3">Le montant définitif est confirmé à la réception des articles.</p>
    }
</section>
