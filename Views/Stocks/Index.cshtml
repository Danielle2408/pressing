@model StockViewModel
@{
    ViewData["Title"] = "Stocks";
    var lowStockCount = Model.Items.Count(item => item.IsActive && item.QuantityOnHand <= item.AlertThreshold);
}

<section class="py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4"><div><span class="text-primary fw-semibold small text-uppercase">Comptoir et atelier</span><h1 class="display-6 fw-bold mt-2 mb-0">Stocks</h1></div>
        @if (lowStockCount > 0) { <span class="badge text-bg-warning fs-6">@lowStockCount alerte(s) de stock bas</span> }
    </div>
    @if (TempData["StockSuccess"] is string success) { <div class="alert alert-success" role="status">@success</div> }
    @if (TempData["StockError"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }

    @if (User.IsInRole(Roles.Administrator))
    {
        <div class="card border-0 shadow-sm mb-4"><div class="card-body p-4"><h2 class="h5">Ajouter un produit</h2>
            <form asp-action="Ajouter" method="post" class="row g-3 mt-1">
                <div class="col-md-3"><label class="form-label" for="item-name">Produit</label><input class="form-control" id="item-name" name="Name" maxlength="120" required /></div>
                <div class="col-md-2"><label class="form-label" for="item-unit">Unité (kg, litre, pièce…)</label><input class="form-control" id="item-unit" name="Unit" maxlength="24" required /></div>
                <div class="col-md-2"><label class="form-label" for="item-initial">Stock initial</label><input class="form-control" id="item-initial" name="InitialQuantity" type="number" min="0" step="0.001" value="0" required /></div>
                <div class="col-md-2"><label class="form-label" for="item-threshold">Seuil d’alerte</label><input class="form-control" id="item-threshold" name="AlertThreshold" type="number" min="0" step="0.001" value="0" required /></div>
                <div class="col-md-3"><label class="form-label" for="item-supplier">Fournisseur</label><input class="form-control" id="item-supplier" name="Supplier" maxlength="120" /></div>
                <div class="col-12"><button class="btn btn-primary" type="submit">Ajouter à l’inventaire</button></div>
            </form>
        </div></div>
    }

    <div class="card border-0 shadow-sm overflow-hidden mb-4"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
        <thead class="table-light"><tr><th>Produit</th><th>Fournisseur</th><th>Stock disponible</th><th>Seuil d’alerte</th><th>État</th>@if (User.IsInRole(Roles.Administrator)) { <th></th> }</tr></thead>
        <tbody>
        @if (Model.Items.Count == 0) { <tr><td colspan="6" class="text-center text-secondary py-5">Aucun produit en stock. L’administrateur peut ajouter les consommables suivis.</td></tr> }
        @foreach (var item in Model.Items)
        {
            var low = item.IsActive && item.QuantityOnHand <= item.AlertThreshold;
            <tr class="@(low ? "table-warning" : "")"><td class="fw-semibold">@item.Name <span class="small text-secondary">(@item.Unit)</span></td><td>@(item.Supplier ?? "—")</td><td>@item.QuantityOnHand.ToString("N3") @item.Unit</td><td>@item.AlertThreshold.ToString("N3") @item.Unit</td><td>@if (!item.IsActive) { <span class="badge text-bg-secondary">Désactivé</span> } else if (low) { <span class="badge text-bg-warning">Stock bas</span> } else { <span class="badge text-bg-success">Disponible</span> }</td>
            @if (User.IsInRole(Roles.Administrator))
            {
                <td class="text-end"><form asp-action="BasculerActivation" method="post"><input type="hidden" name="id" value="@item.Id" /><button class="btn btn-sm btn-outline-secondary" type="submit">@(item.IsActive ? "Désactiver" : "Réactiver")</button></form></td>
            }
            </tr>
        }
        </tbody>
    </table></div></div>

    <div class="card border-0 shadow-sm mb-4"><div class="card-body p-4"><h2 class="h5">Enregistrer une entrée ou une consommation</h2>
        <form asp-action="Mouvement" method="post" class="row g-3 mt-1">
            <div class="col-md-4"><label class="form-label" for="movement-item">Produit</label><select class="form-select" id="movement-item" name="InventoryItemId" required><option value="">Choisir</option>@foreach (var item in Model.Items.Where(item => item.IsActive)) { <option value="@item.Id">@item.Name (@item.QuantityOnHand.ToString("N3") @item.Unit disponible)</option> }</select></div>
            <div class="col-md-3"><label class="form-label" for="movement-direction">Type</label><select class="form-select" id="movement-direction" name="Direction"><option value="Incoming">Entrée / achat</option><option value="Outgoing">Sortie / consommation</option></select></div>
            <div class="col-md-2"><label class="form-label" for="movement-quantity">Quantité</label><input class="form-control" id="movement-quantity" name="Quantity" type="number" min="0.001" step="0.001" required /></div>
            <div class="col-md-3"><label class="form-label" for="movement-note">Note (facultatif)</label><input class="form-control" id="movement-note" name="Note" maxlength="500" /></div>
            <div class="col-12"><button class="btn btn-primary" type="submit">Enregistrer le mouvement</button></div>
        </form>
    </div></div>

    <div class="card border-0 shadow-sm overflow-hidden"><div class="card-body pb-0"><h2 class="h5">Mouvements récents</h2></div><div class="table-responsive"><table class="table table-hover align-middle mb-0">
        <thead class="table-light"><tr><th>Date</th><th>Produit</th><th>Type</th><th>Quantité</th><th>Note</th><th>Enregistré par</th></tr></thead><tbody>
        @if (Model.Movements.Count == 0) { <tr><td colspan="6" class="text-center text-secondary py-4">Aucun mouvement enregistré.</td></tr> }
        @foreach (var movement in Model.Movements) { <tr><td>@movement.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@movement.InventoryItem.Name</td><td>@(movement.Direction == StockMovementDirection.Incoming ? "Entrée" : "Sortie")</td><td>@movement.Quantity.ToString("N3") @movement.InventoryItem.Unit</td><td>@(movement.Note ?? "—")</td><td>@movement.User.FullName</td></tr> }
        </tbody>
    </table></div></div>
</section>
