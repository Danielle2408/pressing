@model IReadOnlyList<AuditLog>
@{
    ViewData["Title"] = "Journal d’audit";
}

<section class="py-4">
    <div class="mb-4"><span class="text-primary fw-semibold small text-uppercase">Administration</span><h1 class="display-6 fw-bold mt-2">Journal d’audit</h1></div>
    <form asp-action="Index" method="get" class="row g-2 mb-4">
        <div class="col-md-3"><label class="form-label" for="date">Date</label><input class="form-control" id="date" name="date" type="date" value="@ViewBag.FilterDate" /></div>
        <div class="col-md-3"><label class="form-label" for="entity">Type d’élément</label><input class="form-control" id="entity" name="entity" value="@ViewBag.FilterEntity" maxlength="80" /></div>
        <div class="col-auto align-self-end"><button class="btn btn-outline-primary" type="submit">Filtrer</button></div>
        <div class="col-auto align-self-end"><a asp-action="Index" class="btn btn-link">Effacer</a></div>
    </form>
    <div class="card border-0 shadow-sm overflow-hidden"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
        <thead class="table-light"><tr><th>Date</th><th>Utilisateur</th><th>Action</th><th>Élément</th><th>Identifiant</th><th>Détails</th></tr></thead><tbody>
        @if (Model.Count == 0) { <tr><td colspan="6" class="text-center text-secondary py-5">Aucune action dans le journal.</td></tr> }
        @foreach (var item in Model) { <tr><td>@item.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</td><td>@item.User.FullName</td><td>@item.Action</td><td>@item.Entity</td><td>@item.EntityId</td><td>@item.Details</td></tr> }
        </tbody>
    </table></div></div>
    @if (Model.Count == 300) { <p class="text-secondary small mt-2">Les 300 actions les plus récentes sont affichées. Filtre par date ou type d’élément.</p> }
</section>
