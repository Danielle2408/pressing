@model CashClosureViewModel
@{
    ViewData["Title"] = "Clôture de caisse";
    var closed = Model.Closure is not null;
}

<section class="py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
        <div><span class="text-primary fw-semibold small text-uppercase">Comptoir</span><h1 class="display-6 fw-bold mt-2 mb-0">Clôture de caisse</h1><p class="text-secondary mb-0">Journée du @Model.BusinessDate.ToString("dd/MM/yyyy")</p></div>
        <a asp-action="Historique" class="btn btn-outline-primary">Historique des clôtures</a>
    </div>
    @if (TempData["CashSuccess"] is string success) { <div class="alert alert-success" role="status">@success</div> }
    @if (TempData["CashError"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
    <div class="row g-3 mb-4">
        <div class="col-md-4"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="small text-secondary">Espèces attendues</div><div class="fs-3 fw-bold mt-2">@Model.ExpectedCash.ToString("N0") FCFA</div></div></div></div>
        <div class="col-md-4"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="small text-secondary">Autres moyens de paiement</div><div class="fs-3 fw-bold mt-2">@Model.OtherPayments.ToString("N0") FCFA</div></div></div></div>
        <div class="col-md-4"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="small text-secondary">Paiements confirmés</div><div class="fs-3 fw-bold mt-2">@Model.PaymentCount</div></div></div></div>
    </div>
    @if (closed)
    {
        <div class="card border-0 shadow-sm"><div class="card-body p-4">
            <span class="badge text-bg-success">Journée clôturée</span>
            <div class="row g-3 mt-2">
                <div class="col-md-4"><div class="small text-secondary">Montant compté</div><div class="fs-4 fw-semibold">@Model.Closure!.CountedCash.ToString("N0") FCFA</div></div>
                <div class="col-md-4"><div class="small text-secondary">Écart</div><div class="fs-4 fw-semibold @(Model.Closure.Variance == 0 ? "text-success" : "text-danger")">@Model.Closure.Variance.ToString("N0") FCFA</div></div>
                <div class="col-md-4"><div class="small text-secondary">Clôturée à</div><div class="fs-5">@Model.Closure.ClosedAtUtc.ToLocalTime().ToString("HH:mm")</div></div>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Closure.Note)) { <p class="mt-3 mb-0">@Model.Closure.Note</p> }
        </div></div>
    }
    else
    {
        <div class="card border-0 shadow-sm"><div class="card-body p-4">
            <h2 class="h5">Compter les espèces</h2>
            <p class="text-secondary">Saisis le montant réellement présent dans la caisse. L’écart sera enregistré pour contrôle.</p>
            <form asp-action="Cloturer" method="post">
                <div class="mb-3"><label class="form-label" for="CountedCash">Espèces comptées (FCFA)</label><input class="form-control" id="CountedCash" name="CountedCash" type="number" min="0" step="1" value="@Model.ExpectedCash.ToString(System.Globalization.CultureInfo.InvariantCulture)" required /></div>
                <div class="mb-3"><label class="form-label" for="Note">Note sur l’écart (facultatif)</label><textarea class="form-control" id="Note" name="Note" maxlength="500" rows="3"></textarea></div>
                <button type="submit" class="btn btn-primary">Clôturer la caisse</button>
            </form>
        </div></div>
    }
</section>
