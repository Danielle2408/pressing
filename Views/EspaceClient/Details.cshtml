@model CustomerOrderDetailsViewModel
@{
    ViewData["Title"] = Model.Order.Number;
    var order = Model.Order;
    var due = order.TotalAmount - order.AmountPaid;
    var pendingOnlinePayment = order.Payments.Any(payment => payment.Method == PaymentMethod.Notchpay && payment.Status == OrderPaymentStatus.Pending);
}

<section class="py-4">
    <a asp-action="Index" class="text-decoration-none">← Retour à mes commandes</a>
    @if (TempData["RequestSuccess"] is string requestSuccess)
    {
        <div class="alert alert-success mt-3" role="status">@requestSuccess</div>
    }
    @if (TempData["ClaimSuccess"] is string claimSuccess) { <div class="alert alert-success mt-3" role="status">@claimSuccess</div> }
    @if (TempData["ClaimError"] is string claimError) { <div class="alert alert-danger mt-3" role="alert">@claimError</div> }
    @if (order.Status == OrderStatus.PendingConfirmation)
    {
        <div class="alert alert-info mt-3">Ta demande attend la confirmation du pressing. Le montant affiché est une estimation.</div>
        <form asp-action="AnnulerDemande" method="post" class="mb-3">
            <input type="hidden" name="id" value="@order.Id" />
            <button type="submit" class="btn btn-outline-danger btn-sm">Annuler ma demande</button>
        </form>
    }
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mt-3 mb-4">
        <div>
            <span class="text-primary fw-semibold small text-uppercase">Suivi de commande</span>
            <h1 class="display-6 fw-bold mt-2">@order.Number</h1>
            <p class="text-secondary mb-0">Déposée le @order.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy à HH:mm")</p>
        </div>
        <span class="badge rounded-pill text-bg-primary fs-6 px-3 py-2">@order.Status.ToFrench()</span>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <h2 class="h5">Articles de la commande</h2>
                    <div class="table-responsive mt-3">
                        <table class="table align-middle mb-0">
                            <thead class="table-light"><tr><th>Article</th><th>Service</th><th>Quantité</th><th class="text-end">Montant</th></tr></thead>
                            <tbody>
                            @foreach (var line in order.Lines)
                            {
                                <tr>
                                    <td>@line.CategoryName
                                        @if (!string.IsNullOrWhiteSpace(line.Color) || !string.IsNullOrWhiteSpace(line.Brand))
                                        {
                                            <div class="small text-secondary">@line.Color @line.Brand</div>
                                        }
                                    </td>
                                    <td>@line.ServiceName</td>
                                    <td>@line.Quantity</td>
                                    <td class="text-end">@line.LineTotal.ToString("N0") FCFA</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h2 class="h5 mb-3">Étapes de traitement</h2>
                    @foreach (var history in order.StatusHistory.OrderBy(item => item.ChangedAtUtc))
                    {
                        <div class="border-start border-2 ps-3 pb-3 ms-1">
                            <div class="fw-semibold">@history.NewStatus.ToFrench()</div>
                            <div class="small text-secondary">@history.ChangedAtUtc.ToLocalTime().ToString("dd/MM/yyyy à HH:mm")</div>
                        </div>
                    }
                </div>
            </div>

            <div class="card border-0 shadow-sm mt-4">
                <div class="card-body p-4">
                    <h2 class="h5">Réclamations</h2>
                    @if (Model.Claims.Count == 0) { <p class="text-secondary mt-3">Aucune réclamation pour cette commande.</p> }
                    @foreach (var claim in Model.Claims)
                    {
                        <div class="border rounded p-3 mt-3">
                            <div class="d-flex justify-content-between gap-2"><strong>@claim.Status.ToFrench()</strong><span class="small text-secondary">@claim.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy")</span></div>
                            <p class="mt-2 mb-0">@claim.Description</p>
                            @if ((claim.Status is ClaimStatus.Resolved or ClaimStatus.Rejected) && !string.IsNullOrWhiteSpace(claim.Decision))
                            {
                                <div class="alert alert-light border mt-3 mb-0"><strong>Décision :</strong> @claim.Decision</div>
                            }
                        </div>
                    }
                    <hr class="my-4" />
                    <h3 class="h6">Déclarer un problème</h3>
                    <form asp-action="Reclamer" method="post" class="mt-3">
                        <input type="hidden" name="OrderId" value="@order.Id" />
                        <label class="form-label" for="claim-description">Description (10 à 2 000 caractères)</label>
                        <textarea class="form-control" id="claim-description" name="Description" rows="4" minlength="10" maxlength="2000" required></textarea>
                        <button type="submit" class="btn btn-outline-primary mt-3">Envoyer la réclamation</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <h2 class="h5">Retrait prévu</h2>
                    <p class="fs-5 fw-semibold mt-3 mb-0">@order.ExpectedReadyAtUtc.ToLocalTime().ToString("dd/MM/yyyy à HH:mm")</p>
                    @if (order.HomeCollection && order.CollectionRequestedAtUtc.HasValue)
                    {
                        <div class="small text-secondary mt-3">Collecte demandée le @order.CollectionRequestedAtUtc.Value.ToLocalTime().ToString("dd/MM/yyyy à HH:mm")</div>
                        @if (!string.IsNullOrWhiteSpace(order.CollectionAddress)) { <div class="small text-secondary">@order.CollectionAddress</div> }
                    }
                    @if (order.HomeDelivery && !string.IsNullOrWhiteSpace(order.DeliveryAddress))
                    {
                        <div class="small text-secondary mt-3">Livraison à : @order.DeliveryAddress</div>
                    }
                    @if (order.Express)
                    {
                        <span class="badge text-bg-info mt-3">Service express</span>
                    }
                </div>
            </div>
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h2 class="h5">Paiement</h2>
                    @if (TempData["PaymentError"] is string paymentError)
                    {
                        <div class="alert alert-warning mt-3">@paymentError</div>
                    }
                    <div class="d-flex justify-content-between mt-3"><span class="text-secondary">Total</span><span>@order.TotalAmount.ToString("N0") FCFA</span></div>
                    <div class="d-flex justify-content-between mt-2"><span class="text-secondary">Payé</span><span>@order.AmountPaid.ToString("N0") FCFA</span></div>
                    <hr />
                    <div class="d-flex justify-content-between fw-semibold"><span>Solde dû</span><span>@due.ToString("N0") FCFA</span></div>
                    @if (due > 0 && order.Status is not (OrderStatus.PendingConfirmation or OrderStatus.Cancelled or OrderStatus.Delivered))
                    {
                        @if (pendingOnlinePayment)
                        {
                            <p class="small text-secondary mt-3">Un paiement en ligne est en attente. Tu peux reprendre le paiement ci-dessous.</p>
                        }
                        <form asp-action="PayerEnLigne" method="post" class="mt-3">
                            <input type="hidden" name="id" value="@order.Id" />
                            <button class="btn btn-primary w-100" type="submit">Payer @due.ToString("N0") FCFA avec Notch Pay</button>
                        </form>
                    }
                    @if (order.Payments.Count > 0)
                    {
                        <div class="small text-secondary mt-3">Historique des paiements</div>
                        @foreach (var payment in order.Payments.OrderByDescending(item => item.CreatedAtUtc))
                        {
                            <div class="d-flex flex-wrap justify-content-between gap-2 border-bottom py-2">
                                <span>@payment.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy") · @payment.Method.ToFrench() · @payment.Status</span>
                                <span class="text-end">@payment.Amount.ToString("N0") FCFA
                                    @if (payment.Status == OrderPaymentStatus.Confirmed && payment.ReceiptNumber is not null)
                                    {
                                        <a asp-action="Recu" asp-route-paymentId="@payment.Id" class="d-block small">Télécharger le reçu PDF</a>
                                    }
                                </span>
                            </div>
                        }
                    }
                    @if (order.DiscountAmount > 0)
                    {
                        <div class="small text-success mt-2">Code @order.PromoCodeSnapshot : −@order.DiscountAmount.ToString("N0") FCFA</div>
                    }
                    <p class="small text-secondary mt-3 mb-0">Les reçus sont disponibles auprès du pressing.</p>
                </div>
            </div>
        </div>
    </div>
</section>
