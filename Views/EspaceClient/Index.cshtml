@model CustomerPortalViewModel
@{
    ViewData["Title"] = "Mon espace";
}

<section class="py-4">
    <div class="mb-4">
        <span class="text-primary fw-semibold small text-uppercase">Espace client</span>
        <h1 class="display-6 fw-bold mt-2">Bonjour @Model.Customer.FullName</h1>
        <p class="text-secondary">Retrouve ici le suivi et l’historique de tes commandes.</p>
    </div>

    <div class="card border-0 shadow-sm mb-4"><div class="card-body p-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div><div class="small text-secondary">Points fidélité disponibles</div><div class="display-6 fw-bold text-primary">@Model.Customer.LoyaltyPoints</div></div>
        <div class="text-secondary">1 point est attribué par tranche complète de @Model.CurrencyPerPoint.ToString("N0") FCFA sur une commande entièrement réglée.</div>
        <a asp-action="Profil" class="btn btn-outline-secondary">Gérer mon profil</a>
    </div></div>
    @if (Model.LoyaltyHistory.Count > 0)
    {
        <details class="mb-4"><summary class="fw-semibold">Historique des points</summary>
            <div class="card border-0 shadow-sm mt-2"><div class="table-responsive"><table class="table table-hover mb-0"><thead class="table-light"><tr><th>Date</th><th>Commande</th><th class="text-end">Points gagnés</th></tr></thead><tbody>
            @foreach (var entry in Model.LoyaltyHistory) { <tr><td>@entry.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy")</td><td>@entry.LaundryOrder.Number</td><td class="text-end">+@entry.Points</td></tr> }
            </tbody></table></div></div>
        </details>
    }

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
        <h2 class="h4 mb-0">Mes commandes</h2>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="NouvelleDemande" class="btn btn-primary">Nouvelle demande</a>
            <a asp-action="Profil" class="btn btn-outline-secondary">Mon profil</a>
            <a asp-controller="Catalogue" asp-action="Index" class="btn btn-outline-primary">Voir les services et tarifs</a>
        </div>
    </div>

    @if (TempData["RequestSuccess"] is string success)
    {
        <div class="alert alert-success" role="status">@success</div>
    }

    <div class="card border-0 shadow-sm overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light"><tr><th>Commande</th><th>Statut</th><th class="text-end">Total</th><th>Retrait prévu</th><th></th></tr></thead>
                <tbody>
                @if (Model.Orders.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-secondary py-5">Aucune commande n’est encore associée à ton compte.</td></tr>
                }
                @foreach (var order in Model.Orders)
                {
                    <tr>
                        <td class="fw-semibold">@order.Number</td>
                        <td><span class="badge rounded-pill text-bg-light border">@order.Status.ToFrench()</span></td>
                        <td class="text-end">@order.TotalAmount.ToString("N0") FCFA</td>
                        <td>@order.ExpectedReadyAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="text-end"><a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-secondary">Suivre</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</section>
