@model CustomerAddressPageViewModel
@{
    ViewData["Title"] = "Mes adresses";
}

<section class="py-4">
    <a asp-action="Profil" class="text-decoration-none">← Retour à mon profil</a>
    <div class="mt-3 mb-4"><span class="text-primary fw-semibold small text-uppercase">Espace client</span><h1 class="display-6 fw-bold mt-2">Mes adresses</h1><p class="text-secondary">Enregistre tes adresses pour les retrouver lors de tes demandes de collecte et de livraison.</p></div>
    @if (TempData["AddressSuccess"] is string success) { <div class="alert alert-success" role="status">@success</div> }
    <div class="row g-4">
        <div class="col-lg-7">
            @if (Model.Addresses.Count == 0) { <div class="alert alert-info">Aucune adresse enregistrée pour le moment.</div> }
            @foreach (var address in Model.Addresses)
            {
                <article class="card border-0 shadow-sm mb-3"><div class="card-body p-4 d-flex flex-column flex-md-row justify-content-between gap-3">
                    <div><h2 class="h5 mb-1">@address.Label @if (address.IsDefault) { <span class="badge text-bg-primary">Par défaut</span> }</h2><p class="mb-0 text-secondary">@address.Address</p></div>
                    <div class="d-flex flex-wrap gap-2 align-items-start">
                        @if (!address.IsDefault) { <form asp-action="DefinirAdresseParDefaut" method="post"><input type="hidden" name="id" value="@address.Id" /><button class="btn btn-outline-primary btn-sm" type="submit">Définir par défaut</button></form> }
                        <form asp-action="DesactiverAdresse" method="post" onsubmit="return confirm('Retirer cette adresse de tes adresses enregistrées ?');"><input type="hidden" name="id" value="@address.Id" /><button class="btn btn-outline-danger btn-sm" type="submit">Retirer</button></form>
                    </div>
                </div></article>
            }
        </div>
        <div class="col-lg-5"><div class="card border-0 shadow-sm"><div class="card-body p-4"><h2 class="h5">Ajouter une adresse</h2>
            <form asp-action="AjouterAdresse" method="post" class="mt-3">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <div class="mb-3"><label asp-for="NewAddress.Label" class="form-label">Nom de l’adresse</label><input asp-for="NewAddress.Label" class="form-control" maxlength="80" placeholder="Maison, bureau…" /><span asp-validation-for="NewAddress.Label" class="text-danger"></span></div>
                <div class="mb-3"><label asp-for="NewAddress.Address" class="form-label">Adresse complète</label><textarea asp-for="NewAddress.Address" class="form-control" rows="3" maxlength="400"></textarea><span asp-validation-for="NewAddress.Address" class="text-danger"></span></div>
                <button type="submit" class="btn btn-primary">Enregistrer l’adresse</button>
            </form>
        </div></div></div>
    </div>
</section>
