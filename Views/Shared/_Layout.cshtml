<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Pressing</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/pressing_app.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-semibold" asp-area="" asp-controller="Home" asp-action="Index">Pressing</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Accueil</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Catalogue" asp-action="Index">Services et tarifs</a>
                        </li>
                        @if (User.IsInRole("Administrateur"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="CatalogueAdmin" asp-action="Index">Administration</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="AdministrationUtilisateurs" asp-action="Index">Utilisateurs</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Finances" asp-action="Index">Finances</a>
                            </li>
                        }
                        @if (User.IsInRole("Administrateur") || User.IsInRole("Operateur"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Clients" asp-action="Index">Clients</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Commandes" asp-action="Index">Commandes</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Caisse" asp-action="Index">Caisse</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Stocks" asp-action="Index">Stocks</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Reclamations" asp-action="Index">Réclamations</a>
                            </li>
                        }
                        @if (User.IsInRole("Client"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="EspaceClient" asp-action="Index">Mon espace</a>
                            </li>
                        }
                        <li class="nav-item">
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <form asp-controller="Compte" asp-action="Deconnexion" method="post" class="d-inline">
                                    <button type="submit" class="nav-link text-dark border-0 bg-transparent">Déconnexion</button>
                                </form>
                            }
                            else
                            {
                                <a class="nav-link text-dark" asp-controller="Compte" asp-action="Connexion">Connexion</a>
                                <a class="nav-link text-dark" asp-controller="Compte" asp-action="Inscription">Inscription</a>
                            }
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Pressing
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
