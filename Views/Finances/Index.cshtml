@model FinanceReportViewModel
@{
    ViewData["Title"] = "Finances";
    var profit = Model.Revenue - Model.Expenses;
}

<section class="py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4"><div><span class="text-primary fw-semibold small text-uppercase">Administration</span><h1 class="display-6 fw-bold mt-2 mb-0">Finances</h1></div><a asp-controller="Caisse" asp-action="Historique" class="btn btn-outline-primary">Clôtures de caisse</a></div>
    @if (TempData["FinanceSuccess"] is string success) { <div class="alert alert-success" role="status">@success</div> }
    @if (TempData["FinanceError"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
    <form asp-action="Index" method="get" class="row g-2 mb-4">
        <div class="col-md-3"><label class="form-label" for="from">Du</label><input class="form-control" id="from" name="from" type="date" value="@Model.From.ToString("yyyy-MM-dd")" /></div>
        <div class="col-md-3"><label class="form-label" for="to">Au</label><input class="form-control" id="to" name="to" type="date" value="@Model.To.ToString("yyyy-MM-dd")" /></div>
        <div class="col-auto align-self-end"><button type="submit" class="btn btn-outline-primary">Afficher</button></div>
    </form>
    <div class="row g-3 mb-4">
        <div class="col-md-4"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="small text-secondary">Recettes encaissées</div><div class="fs-3 fw-bold mt-2">@Model.Revenue.ToString("N0") FCFA</div></div></div></div>
        <div class="col-md-4"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="small text-secondary">Dépenses</div><div class="fs-3 fw-bold mt-2">@Model.Expenses.ToString("N0") FCFA</div></div></div></div>
        <div class="col-md-4"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="small text-secondary">Solde recettes moins dépenses</div><div class="fs-3 fw-bold mt-2 @(profit >= 0 ? "text-success" : "text-danger")">@profit.ToString("N0") FCFA</div></div></div></div>
    </div>
    <div class="row g-4">
        <div class="col-lg-5"><div class="card border-0 shadow-sm h-100"><div class="card-body p-4"><h2 class="h5">Recettes par moyen de paiement</h2>
            @if (Model.Methods.Count == 0) { <p class="text-secondary mt-3">Aucun paiement confirmé sur la période.</p> }
            @foreach (var method in Model.Methods) { <div class="d-flex justify-content-between border-bottom py-2"><span>@method.Method.ToFrench() <span class="small text-secondary">(@method.Count)</span></span><strong>@method.Amount.ToString("N0") FCFA</strong></div> }
        </div></div></div>
        <div class="col-lg-7"><div class="card border-0 shadow-sm"><div class="card-body p-4"><h2 class="h5">Enregistrer une dépense</h2>
            <form asp-action="AjouterDepense" method="post" class="row g-3 mt-1">
                <div class="col-md-6"><label class="form-label" for="expense-label">Libellé</label><input id="expense-label" name="Label" class="form-control" maxlength="160" required /></div>
                <div class="col-md-6"><label class="form-label" for="expense-category">Catégorie</label><input id="expense-category" name="Category" class="form-control" maxlength="80" placeholder="Loyer, énergie, produits…" required /></div>
                <div class="col-md-6"><label class="form-label" for="expense-amount">Montant (FCFA)</label><input id="expense-amount" name="Amount" class="form-control" type="number" min="1" step="1" required /></div>
                <div class="col-md-6"><label class="form-label" for="expense-date">Date de la dépense</label><input id="expense-date" name="SpentOn" class="form-control" type="date" value="@DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd")" required /></div>
                <div class="col-12"><button class="btn btn-primary" type="submit">Enregistrer la dépense</button></div>
            </form>
        </div></div></div>
        <div class="col-12"><div class="card border-0 shadow-sm overflow-hidden"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr><th>Date</th><th>Libellé</th><th>Catégorie</th><th>Enregistrée par</th><th class="text-end">Montant</th></tr></thead><tbody>
            @if (Model.ExpenseItems.Count == 0) { <tr><td colspan="5" class="text-center text-secondary py-4">Aucune dépense sur la période.</td></tr> }
            @foreach (var expense in Model.ExpenseItems) { <tr><td>@expense.SpentAtUtc.ToLocalTime().ToString("dd/MM/yyyy")</td><td>@expense.Label</td><td>@expense.Category</td><td>@expense.CreatedByUser.FullName</td><td class="text-end">@expense.Amount.ToString("N0") FCFA</td></tr> }
            </tbody>
        </table></div></div></div>
    </div>
</section>
