@model ResetStaffPasswordViewModel
@{
    ViewData["Title"] = "Réinitialiser le mot de passe";
}

<section class="py-4">
    <a asp-action="Index" class="text-decoration-none">← Retour aux utilisateurs</a>
    <div class="mt-3 mb-4"><span class="text-primary fw-semibold small text-uppercase">Administration</span><h1 class="display-6 fw-bold mt-2">Réinitialiser le mot de passe</h1><p class="text-secondary">Compte : @Model.FullName</p></div>
    <div class="card border-0 shadow-sm"><div class="card-body p-4">
        <form asp-action="ReinitialiserMotDePasse" method="post">
            <input asp-for="UserId" type="hidden" /><input asp-for="FullName" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="mb-3"><label asp-for="TemporaryPassword" class="form-label"></label><input asp-for="TemporaryPassword" class="form-control" /><div class="form-text">Au moins 10 caractères, avec majuscule et chiffre. Transmets le mot de passe de manière sécurisée.</div><span asp-validation-for="TemporaryPassword" class="text-danger"></span></div>
            <button type="submit" class="btn btn-primary">Réinitialiser</button>
        </form>
    </div></div>
</section>
