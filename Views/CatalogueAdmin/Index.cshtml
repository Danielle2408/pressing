@model AdminCatalogueViewModel
@{
    ViewData["Title"] = "Gestion du catalogue";
}

<section class="py-4">
    <div class="mb-4">
        <span class="text-primary fw-semibold small text-uppercase">Administration</span>
        <h1 class="display-6 fw-bold mt-2">Services et tarifs</h1>
        <p class="text-secondary">Les changements de prix créent une nouvelle période et préservent l’historique.</p>
    </div>

    @if (TempData["CatalogueError"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }
    @if (TempData["CatalogueSuccess"] is string success)
    {
        <div class="alert alert-success" role="status">@success</div>
    }

    <div class="row g-4 mb-4">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <h2 class="h5">Catégories d’articles</h2>
                    <form asp-action="AjouterCategorie" method="post" class="d-flex gap-2 my-3">
                        <input name="name" class="form-control" maxlength="100" placeholder="Ex. Chemise" required />
                        <button class="btn btn-primary text-nowrap" type="submit">Ajouter</button>
                    </form>
                    <div class="list-group list-group-flush">
                    @foreach (var category in Model.Categories)
                    {
                        <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span>@category.Name</span>
                            <form asp-action="BasculerCategorie" method="post">
                                <input type="hidden" name="id" value="@category.Id" />
                                <button class="btn btn-sm @(category.IsActive ? "btn-outline-danger" : "btn-outline-success")" type="submit">
                                    @(category.IsActive ? "Désactiver" : "Réactiver")
                                </button>
                            </form>
                        </div>
                    }
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <h2 class="h5">Types de service</h2>
                    <form asp-action="AjouterService" method="post" class="d-flex gap-2 my-3">
                        <input name="name" class="form-control" maxlength="100" placeholder="Ex. Nettoyage à sec" required />
                        <button class="btn btn-primary text-nowrap" type="submit">Ajouter</button>
                    </form>
                    <div class="list-group list-group-flush">
                    @foreach (var service in Model.Services)
                    {
                        <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span>@service.Name</span>
                            <form asp-action="BasculerService" method="post">
                                <input type="hidden" name="id" value="@service.Id" />
                                <button class="btn btn-sm @(service.IsActive ? "btn-outline-danger" : "btn-outline-success")" type="submit">
                                    @(service.IsActive ? "Désactiver" : "Réactiver")
                                </button>
                            </form>
                        </div>
                    }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <h2 class="h5">Définir un tarif</h2>
            <form asp-action="ModifierTarif" method="post" class="row g-3 align-items-end mt-1">
                <div class="col-md-4">
                    <label class="form-label" for="categoryId">Article</label>
                    <select class="form-select" id="categoryId" name="categoryId" asp-items="ViewBag.CategoryOptions" required>
                        <option value="">Choisir un article</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="serviceId">Service</label>
                    <select class="form-select" id="serviceId" name="serviceId" asp-items="ViewBag.ServiceOptions" required>
                        <option value="">Choisir un service</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="price">Prix en FCFA</label>
                    <input class="form-control" id="price" name="price" type="number" min="1" max="100000000" step="1" required />
                </div>
                <div class="col-md-2"><button class="btn btn-primary w-100" type="submit">Enregistrer</button></div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <h2 class="h5">Historique des tarifs</h2>
            @if (Model.Tariffs.Count == 0)
            {
                <p class="text-secondary mb-0">Aucun tarif n’a encore été enregistré.</p>
            }
            else
            {
                <div class="table-responsive mt-3">
                    <table class="table align-middle mb-0">
                        <thead class="table-light"><tr><th>Article</th><th>Service</th><th class="text-end">Prix</th><th>Début</th><th>Fin</th></tr></thead>
                        <tbody>
                        @foreach (var tariff in Model.Tariffs)
                        {
                            <tr>
                                <td>@tariff.GarmentCategory.Name</td>
                                <td>@tariff.LaundryService.Name</td>
                                <td class="text-end">@tariff.Price.ToString("N0") FCFA</td>
                                <td>@tariff.ValidFromUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@(tariff.ValidUntilUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "En vigueur")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</section>
