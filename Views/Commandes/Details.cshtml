@model OrderDetailsViewModel
@{
    ViewData["Title"] = Model.Order.Number;
    var order = Model.Order;
    var lineAmount = order.Lines.Sum(line => line.LineTotal);
}

<section class="py-4">
    <a asp-action="Index" class="text-decoration-none">← Retour aux commandes</a>
    @if (TempData["OrderSuccess"] is string success)
    {
        <div class="alert alert-success mt-3" role="status">@success</div>
    }
    @if (TempData["OrderError"] is string error)
    {
        <div class="alert alert-danger mt-3" role="alert">@error</div>
    }

    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mt-3 mb-4">
        <div>
            <span class="text-primary fw-semibold small text-uppercase">Commande</span>
            <h1 class="display-6 fw-bold mt-2">@order.Number</h1>
            <div class="text-secondary">Créée le @order.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy à HH:mm") par @order.CreatedByUser.FullName</div>
        </div>
        <span class="badge rounded-pill text-bg-primary fs-6 px-3 py-2">@order.Status.ToFrench()</span>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <h2 class="h5">Articles</h2>
                    <div class="table-responsive mt-3">
                        <table class="table align-middle mb-0">
                            <thead class="table-light"><tr><th>Article</th><th>Service</th><th>Quantité</th><th class="text-end">Prix unitaire</th><th class="text-end">Total</th></tr></thead>
                            <tbody>
                            @foreach (var line in order.Lines)
                            {
                                <tr>
                                    <td>@line.CategoryName
                                        @if (!string.IsNullOrWhiteSpace(line.Color) || !string.IsNullOrWhiteSpace(line.Brand))
                                        {
                                            <div class="small text-secondary">@line.Color @line.Brand</div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(line.ReceptionCondition))
                                        {
                                            <div class="small text-warning-emphasis">État : @line.ReceptionCondition</div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(line.Notes))
                                        {
                                            <div class="small text-secondary">Note : @line.Notes</div>
                                        }
                                    </td>
                                    <td>@line.ServiceName</td>
                                    <td>@line.Quantity</td>
                                    <td class="text-end">@line.UnitPrice.ToString("N0") FCFA</td>
                                    <td class="text-end fw-semibold">@line.LineTotal.ToString("N0") FCFA</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(order.Notes))
                    {
                        <div class="alert alert-light border mt-3 mb-0"><strong>Remarque :</strong> @order.Notes</div>
                    }
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h2 class="h5 mb-3">Historique de traitement</h2>
                    <div class="timeline">
                    @foreach (var history in order.StatusHistory.OrderByDescending(item => item.ChangedAtUtc))
                    {
                        <div class="timeline-item pb-3">
                            <div class="fw-semibold">@history.NewStatus.ToFrench()</div>
                            <div class="small text-secondary">@history.ChangedAtUtc.ToLocalTime().ToString("dd/MM/yyyy à HH:mm") · @history.User.FullName</div>
                            @if (!string.IsNullOrWhiteSpace(history.Reason))
                            {
                                <div class="small mt-1">@history.Reason</div>
                            }
                        </div>
                    }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <h2 class="h5">Client</h2>
                    <div class="fw-semibold mt-3">@order.Customer.FullName</div>
                    <div class="text-secondary">@order.Customer.PhoneNumber</div>
                    @if (!string.IsNullOrWhiteSpace(order.Customer.Address))
                    {
                        <div class="text-secondary small mt-2">@order.Customer.Address</div>
                    }
                    <hr />
                    <div class="small text-secondary">Retrait prévu</div>
                    <div class="fw-semibold">@order.ExpectedReadyAtUtc.ToLocalTime().ToString("dd/MM/yyyy à HH:mm")</div>
                    @if (order.Express || order.HomeCollection || order.HomeDelivery)
                    {
                        <div class="d-flex flex-wrap gap-2 mt-3">
                            @if (order.Express) { <span class="badge text-bg-info">Express</span> }
                            @if (order.HomeCollection) { <span class="badge text-bg-light border">Collecte domicile</span> }
                            @if (order.HomeDelivery) { <span class="badge text-bg-light border">Livraison domicile</span> }
                        </div>
                    }
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <h2 class="h5">Récapitulatif</h2>
                    <div class="d-flex justify-content-between mt-3"><span class="text-secondary">Articles</span><span>@lineAmount.ToString("N0") FCFA</span></div>
                    @if (order.ExpressSurcharge > 0)
                    {
                        <div class="d-flex justify-content-between mt-2"><span class="text-secondary">Supplément express</span><span>@order.ExpressSurcharge.ToString("N0") FCFA</span></div>
                    }
                    @if (order.CollectionFee > 0)
                    {
                        <div class="d-flex justify-content-between mt-2"><span class="text-secondary">Collecte</span><span>@order.CollectionFee.ToString("N0") FCFA</span></div>
                    }
                    @if (order.DeliveryFee > 0)
                    {
                        <div class="d-flex justify-content-between mt-2"><span class="text-secondary">Livraison</span><span>@order.DeliveryFee.ToString("N0") FCFA</span></div>
                    }
                    <hr />
                    <div class="d-flex justify-content-between fw-semibold"><span>Total</span><span>@order.TotalAmount.ToString("N0") FCFA</span></div>
                    <div class="d-flex justify-content-between mt-2"><span class="text-secondary">Payé</span><span>@order.AmountPaid.ToString("N0") FCFA</span></div>
                    <div class="d-flex justify-content-between mt-2"><span class="fw-semibold">Solde dû</span><span class="fw-semibold">@((order.TotalAmount - order.AmountPaid).ToString("N0")) FCFA</span></div>
                    @if (order.Status == OrderStatus.Cancelled && !string.IsNullOrWhiteSpace(order.CancellationReason))
                    {
                        <div class="alert alert-warning mt-3 mb-0"><strong>Motif d’annulation :</strong> @order.CancellationReason</div>
                    }
                </div>
            </div>

            @if (Model.AllowedStatuses.Count > 0)
            {
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <h2 class="h5">Mettre à jour le statut</h2>
                        <form asp-action="ChangerStatut" method="post" class="mt-3">
                            <input type="hidden" name="id" value="@order.Id" />
                            <label class="form-label" for="new-status">Nouveau statut</label>
                            <select class="form-select" id="new-status" name="status" required>
                                @foreach (var status in Model.AllowedStatuses)
                                {
                                    <option value="@((int)status)">@status.ToFrench()</option>
                                }
                            </select>
                            <label class="form-label mt-3" for="reason">Note ou motif d’annulation</label>
                            <textarea class="form-control" id="reason" name="reason" rows="2" maxlength="500"></textarea>
                            <button type="submit" class="btn btn-primary w-100 mt-3">Confirmer le changement</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
