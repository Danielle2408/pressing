@model OrderListViewModel
@{
    ViewData["Title"] = "Commandes";
}

<section class="py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
        <div>
            <span class="text-primary fw-semibold small text-uppercase">Comptoir et atelier</span>
            <h1 class="display-6 fw-bold mt-2 mb-0">Commandes</h1>
        </div>
        <a asp-action="Creer" class="btn btn-primary">Nouvelle commande</a>
    </div>

    @if (TempData["OrderSuccess"] is string success)
    {
        <div class="alert alert-success" role="status">@success</div>
    }
    <form asp-action="Index" method="get" class="row g-2 mb-4">
        <div class="col-md-4">
            <label class="visually-hidden" for="query">Numéro, client ou téléphone</label>
            <input class="form-control" id="query" name="query" value="@Model.Query" placeholder="Numéro, client, téléphone ou code QR" />
        </div>
        <div class="col-md-3">
            <label class="visually-hidden" for="status">Statut</label>
            <select class="form-select" id="status" name="status">
                <option value="">Tous les statuts</option>
                @foreach (var status in Enum.GetValues<OrderStatus>())
                {
                    if (Model.Status == status)
                    {
                        <option value="@((int)status)" selected>@status.ToFrench()</option>
                    }
                    else
                    {
                        <option value="@((int)status)">@status.ToFrench()</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-2"><button class="btn btn-outline-primary w-100" type="submit">Filtrer</button></div>
        @if (!string.IsNullOrWhiteSpace(Model.Query) || Model.Status.HasValue)
        {
            <div class="col-md-2"><a asp-action="Index" class="btn btn-link">Effacer les filtres</a></div>
        }
    </form>

    <div class="card border-0 shadow-sm overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light"><tr><th>Commande</th><th>Client</th><th>Statut</th><th class="text-end">Total</th><th>Retrait prévu</th><th></th></tr></thead>
                <tbody>
                @if (Model.Orders.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-secondary py-5">Aucune commande trouvée.</td></tr>
                }
                @foreach (var order in Model.Orders)
                {
                    <tr>
                        <td class="fw-semibold">@order.Number</td>
                        <td>@order.Customer.FullName<br /><span class="small text-secondary">@order.Customer.PhoneNumber</span></td>
                        <td><span class="badge rounded-pill text-bg-light border">@order.Status.ToFrench()</span></td>
                        <td class="text-end">@order.TotalAmount.ToString("N0") FCFA</td>
                        <td>@order.ExpectedReadyAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="text-end"><a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-secondary">Détails</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
    @if (Model.Orders.Count == 100)
    {
        <p class="text-secondary small mt-2">Les 100 commandes les plus récentes sont affichées. Utilise les filtres pour affiner la recherche.</p>
    }
</section>
